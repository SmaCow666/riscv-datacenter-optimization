+// Untied/unconstrained tasks without a dependency node need neither the
+// tied-task ancestry walk nor mutexinoutset lock acquisition.
+__forceinline static bool
+__kmp_task_is_allowed_fast(int gtid, const kmp_int32 is_constrained,
+                      const kmp_taskdata_t *tasknew,
+                      const kmp_taskdata_t *taskcurr) {
+#if KMP_ARCH_RISCV64 && KMP_OS_LINUX
+  if ((!is_constrained || tasknew->td_flags.tiedness == TASK_UNTIED) &&
+      tasknew->td_depnode == nullptr)
+    return true;
+#endif
+  return __kmp_task_is_allowed(gtid, is_constrained, tasknew, taskcurr);
 }
 
